rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{user} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == user;

      match /folders/{folder} {
        // Match UI values: saved page uses lowercase "public"; legacy data may use "Public"
        allow read: if request.auth != null &&
          (request.auth.uid == user ||
           resource.data.privacy == 'public' ||
           resource.data.privacy == 'Public');
        allow write: if request.auth != null && request.auth.uid == user;
      }

      match /likedRecipes/{recipeId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == user;
      }

      match /likes/{mealId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == user;
      }

      match /followers/{followerUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
                              && request.auth.uid == followerUid
                              && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null
                      && request.auth.uid == followerUid;
      }

      match /following/{followingUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
                              && request.auth.uid == user
                              && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null
                      && (request.auth.uid == user
                          || resource.data.targetUid == request.auth.uid);
      }
    }

    match /recipes/{mealId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null
                      && resource.data.uid == request.auth.uid;
      }

      match /ratings/{userId} {
        allow read: if true;
        allow write: if request.auth != null
                     && request.auth.uid == userId;
      }

      match /mades/{madeUid} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.uid == madeUid
                      && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null
                      && request.auth.uid == madeUid
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null
                      && request.auth.uid == madeUid;
      }
    }

    match /conversations/{convId} {
      allow read, write: if request.auth != null;

      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
                      && resource.data.uid == request.auth.uid;
      }
    }

  }
}
